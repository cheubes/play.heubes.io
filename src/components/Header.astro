---
import LanguageSelector from './LanguageSelector.astro';
import { createTranslator, getLocalizedPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
---

<header class="site-header">
  <a class="button button-primary skip-link" href="#main">{t('header.skip-to-content')}</a>
  <div class="container site-header-inner">
    <a class="logo" href={getLocalizedPath(locale)}>
      <span class="logo-play">play</span><span class="logo-domain">.heubes.io</span>
    </a>
    <nav aria-label={t('header.language')}>
      <LanguageSelector locale={locale} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-chrome);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .skip-link {
    position: absolute;
    top: var(--space-1);
    inset-inline-start: max(var(--container-margin), env(safe-area-inset-left));
    z-index: 1;
    text-decoration: none;
  }

  .skip-link:not(:focus) {
    transform: translateY(calc(-100% - var(--space-2)));
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--font-size-lg);
    letter-spacing: var(--letter-spacing-display);
    text-decoration: none;
  }

  .logo-play {
    color: var(--color-accent);
  }

  .logo-domain {
    color: var(--color-text-muted);
  }
</style>
