---
import GamePanel from './GamePanel.astro';
import Icon from '../Icon.astro';
import { createTranslator, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  hasLevels: boolean;
}

const { locale, hasLevels } = Astro.props;
const t = createTranslator(locale);
---

<GamePanel id="end">
  <div class="panel-heading">
    <h2 id="game-panel-end-title" class="end-title">
      <span class="end-star" data-end-star hidden>
        <Icon name="star" />
        <span class="visually-hidden">{t('game.end.perfect')}</span>
      </span>
      {
        hasLevels ? (
          <>
            <span data-end-title="level">{t('game.end.title')}</span>
            <span data-end-title="all" hidden>
              {t('game.end.all-complete')}
            </span>
            <span data-end-title="failed" hidden>
              {t('game.end.failed')}
            </span>
          </>
        ) : (
          <span>{t('game.end.game-over')}</span>
        )
      }
    </h2>
    <p class="panel-level" data-panel-level hidden></p>
  </div>
  <p class="end-message" data-end-message hidden></p>
  <dl class="end-stats" data-end-stats></dl>
  <div class="panel-actions">
    {
      hasLevels ? (
        <>
          <button type="button" class="button button-primary" data-command="next" data-end-when="next">
            {t('game.end.next')}
            <Icon name="chevron-right" />
          </button>
          <button type="button" class="button button-primary" data-command="exit" data-end-when="no-next" hidden>
            <Icon name="layout-grid" />
            {t('game.levels')}
          </button>
          <button type="button" class="button button-primary" data-command="restart" data-end-when="failed" hidden>
            <Icon name="rotate-ccw" />
            {t('game.end.try-again')}
          </button>
          <button type="button" class="button button-secondary" data-command="restart" data-end-when="next no-next">
            <Icon name="rotate-ccw" />
            {t('game.end.replay')}
          </button>
          <button type="button" class="button button-secondary" data-command="exit" data-end-when="next failed">
            <Icon name="layout-grid" />
            {t('game.levels')}
          </button>
        </>
      ) : (
        <>
          <button type="button" class="button button-primary" data-command="restart">
            <Icon name="rotate-ccw" />
            {t('game.end.play-again')}
          </button>
          <button type="button" class="button button-secondary" data-command="exit">
            {t('game.quit')}
          </button>
        </>
      )
    }
  </div>
</GamePanel>

<style>
  .end-title {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .end-star {
    color: var(--color-highlight);
    animation: star-in var(--duration-slow) var(--ease-out);
  }

  .end-message {
    color: var(--color-text-muted);
  }

  .end-stats {
    display: grid;
    gap: var(--space-2);
  }

  .end-stats:empty {
    display: none;
  }

  .end-stats :global(div) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .end-stats :global(dt) {
    color: var(--color-text-muted);
  }

  .end-stats :global(dd) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--font-size-lg);
    font-variant-numeric: tabular-nums;
  }

  :global([data-panel='end'][data-perfect] .game-panel) {
    box-shadow: var(--glow-highlight);
  }

  @keyframes star-in {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  @keyframes star-fade-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .end-star {
      animation: star-fade-in var(--duration-fast) var(--ease-out);
    }
  }
</style>
