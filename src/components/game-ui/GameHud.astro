---
import Icon from '../Icon.astro';
import { createTranslator, type Locale } from '../../i18n';
import { formatShortcut } from '../../games/shell/i18n';

export interface HudAction {
  id: string;
  icon: string;
  label: string;
  shortcut?: string | undefined;
}

interface Props {
  locale: Locale;
  actions: HudAction[];
}

const { locale, actions } = Astro.props;
const t = createTranslator(locale);

const tooltip = (label: string, keys?: string) => (keys ? `${label} (${keys})` : label);
---

<div class="game-hud" data-hud>
  <div class="hud-start">
    <button
      type="button"
      class="button-icon"
      data-command="pause"
      aria-label={t('game.hud.pause')}
      aria-keyshortcuts="Escape P"
      title={tooltip(t('game.hud.pause'), `${t('game.keys.escape')} / P`)}
    >
      <Icon name="pause" />
    </button>
    <div class="hud-level">
      <span class="hud-level-text" data-hud-level></span>
    </div>
  </div>
  <dl class="hud-stats" data-hud-stats></dl>
  <div class="hud-end">
    {
      actions.map((action) => (
        <button
          type="button"
          class="button-icon"
          data-action-id={action.id}
          aria-label={action.label}
          aria-keyshortcuts={action.shortcut}
          title={tooltip(action.label, action.shortcut && formatShortcut(action.shortcut))}
        >
          <Icon name={action.icon} />
        </button>
      ))
    }
    <button
      type="button"
      class="button-icon"
      data-command="restart"
      aria-label={t('game.hud.restart')}
      aria-keyshortcuts="R"
      title={tooltip(t('game.hud.restart'), 'R')}
    >
      <Icon name="rotate-ccw" />
    </button>
    <button type="button" class="button-icon toggle" data-command="sound" aria-pressed="true" aria-label={t('game.hud.sound')} title={t('game.hud.sound')}>
      <span class="toggle-on"><Icon name="volume-2" /></span>
      <span class="toggle-off"><Icon name="volume-x" /></span>
    </button>
    <button
      type="button"
      class="button-icon toggle"
      data-command="fullscreen"
      aria-pressed="false"
      aria-label={t('game.hud.fullscreen')}
      title={t('game.hud.fullscreen')}
      hidden
    >
      <span class="toggle-on"><Icon name="minimize" /></span>
      <span class="toggle-off"><Icon name="maximize" /></span>
    </button>
  </div>
</div>

<style>
  .game-hud {
    display: grid;
    grid-template-columns: minmax(var(--touch-target), 1fr) auto 1fr;
    align-items: center;
    gap: var(--space-2);
    flex: none;
    height: calc(56px + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    padding-inline: max(var(--space-2), env(safe-area-inset-left)) max(var(--space-2), env(safe-area-inset-right));
    background-color: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .hud-start,
  .hud-end {
    display: flex;
    align-items: center;
  }

  .hud-start {
    min-width: 0;
  }

  .hud-end {
    justify-content: flex-end;
  }

  /* The zero-width ::before keeps the first line; a label too wide for it wraps to a clipped second line. */
  .hud-level {
    display: flex;
    flex-wrap: wrap;
    flex: 1;
    min-width: 0;
    height: 56px;
    overflow: hidden;
  }

  .hud-level::before {
    content: '';
    height: 56px;
  }

  .hud-level-text {
    align-self: center;
    padding-inline: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--letter-spacing-display);
    white-space: nowrap;
  }

  .hud-stats {
    display: flex;
    gap: var(--space-4);
  }

  .hud-stats :global(div) {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hud-stats :global(dt) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-size-xs);
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hud-stats :global(dd) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--font-size-lg);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .toggle[aria-pressed='true'] .toggle-off,
  .toggle[aria-pressed='false'] .toggle-on {
    display: none;
  }
</style>
