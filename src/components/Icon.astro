---
interface Props {
  name: string;
  size?: 16 | 24;
}

const { name, size = 24 } = Astro.props;

const icons = import.meta.glob<string>('/src/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const source = icons[`/src/icons/${name}.svg`];
if (source === undefined) {
  throw new Error(`Unknown icon "${name}": add it to src/icons/ and to "Iconographie" in specs/style-guide.md.`);
}

const content = source.match(/<svg[^>]*>([\s\S]*)<\/svg>/)?.[1] ?? '';
---

<svg
  class="icon"
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={content}
/>
