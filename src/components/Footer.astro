---
const links = [
  { label: 'License', href: '/about/#license' },
  { label: 'About', href: '/about/' },
  { label: 'Created by Christophe Heubès', href: 'https://christophe.heubes.org/' },
];
---

<footer class="site-footer">
  <ul class="site-footer-links">
    {
      links.map((link, index) => (
        <li>
          {index > 0 && (
            <span class="separator" aria-hidden="true">
              ·
            </span>
          )}
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .site-footer {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-chrome);
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--footer-height);
    padding-bottom: env(safe-area-inset-bottom);
    padding-inline: max(var(--container-margin), env(safe-area-inset-left)) max(var(--container-margin), env(safe-area-inset-right));
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .separator {
    padding-inline: var(--space-1);
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text);
  }

  @media (min-width: 640px) {
    .site-footer {
      font-size: var(--font-size-sm);
    }

    .separator {
      padding-inline: var(--space-2);
    }
  }
</style>
