---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import { createTranslator, getAlternatePath, LOCALES, type Locale } from '../i18n';

export interface ShareImage {
  path: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: ShareImage;
  // A page without a URL of its own (404): not indexed, not shared, not translated.
  noindex?: boolean;
}

const OG_LOCALES: Record<Locale, string> = { en: 'en_US', fr: 'fr_FR' };
// Mirrors --color-bg: a meta tag cannot read custom properties.
const THEME_COLOR = '#0b0f17';

const { title, description, locale, image, noindex = false } = Astro.props;
const t = createTranslator(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = image ?? { path: '/og-image.png', width: 1200, height: 630, alt: t('share.default-image-alt') };
const imageUrl = new URL(shareImage.path, Astro.site).href;
const imageType = shareImage.path.endsWith('.webp') ? 'image/webp' : 'image/png';
const alternates = [
  ...LOCALES.map((language) => ({ hreflang: language, href: new URL(getAlternatePath(Astro.url.pathname, language), Astro.site).href })),
  { hreflang: 'x-default', href: new URL(getAlternatePath(Astro.url.pathname, 'en'), Astro.site).href },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={THEME_COLOR} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonicalUrl} />
          {alternates.map((alternate) => (
            <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
          ))}
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="play.heubes.io" />
          <meta property="og:locale" content={OG_LOCALES[locale]} />
          {LOCALES.filter((language) => language !== locale).map((language) => (
            <meta property="og:locale:alternate" content={OG_LOCALES[language]} />
          ))}
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:type" content={imageType} />
          <meta property="og:image:width" content={String(shareImage.width)} />
          <meta property="og:image:height" content={String(shareImage.height)} />
          <meta property="og:image:alt" content={shareImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image:alt" content={shareImage.alt} />
        </>
      )
    }
    <link rel="preload" href="/fonts/inter/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/chakra-petch/chakra-petch-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} languageSelector={!noindex} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <span id="new-tab-hint" hidden>{t('link.new-tab')}</span>
  </body>
</html>
