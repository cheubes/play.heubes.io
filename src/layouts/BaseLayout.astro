---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import { createTranslator, getAlternatePath, LOCALES, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: string;
}

const { title, description, locale, image = '/og-image.png' } = Astro.props;
const t = createTranslator(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const alternates = [
  ...LOCALES.map((language) => ({ hreflang: language, href: new URL(getAlternatePath(Astro.url.pathname, language), Astro.site).href })),
  { hreflang: 'x-default', href: new URL(getAlternatePath(Astro.url.pathname, 'en'), Astro.site).href },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/inter/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/chakra-petch/chakra-petch-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <span id="new-tab-hint" hidden>{t('link.new-tab')}</span>
  </body>
</html>
