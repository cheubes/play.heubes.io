---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import GameHost from '../components/game-ui/GameHost.astro';
import LevelSelector from '../components/game-ui/LevelSelector.astro';
import { createTranslator, type Locale } from '../i18n';
import { createGameTranslator, type Dictionary } from '../games/shell/i18n';
import type { GameDefinition, GameStorage } from '../games/shell/types';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'games'>;
}

const { locale, entry } = Astro.props;
const t = createTranslator(locale);
const game = entry.data;
const { Content } = await render(entry);
const slug = entry.id.slice(0, -`.${locale}`.length);

const definitions = import.meta.glob<GameDefinition>('/src/games/*/index.ts', { import: 'default' });
const dictionaries = import.meta.glob<Dictionary>('/src/games/*/i18n/*.json', { import: 'default', eager: true });
const loadDefinition = definitions[`/src/games/${slug}/index.ts`];
const dictionary = dictionaries[`/src/games/${slug}/i18n/${locale}.json`];
if (!loadDefinition || !dictionary) {
  throw new Error(`Game "${slug}" has no entry point or no "${locale}" translations.`);
}
const definition = await loadDefinition();
const tGame = createGameTranslator(dictionary, locale);
const actions = (definition.actions ?? []).map((action) => ({
  id: action.id,
  icon: action.icon,
  label: tGame(action.labelKey),
  shortcut: action.shortcut,
}));
const EMPTY_STORAGE: GameStorage = { read: () => undefined, write: () => {} };
const levels = definition.getLevels?.(EMPTY_STORAGE);
---

<BaseLayout
  title={`${game.title} | play.heubes.io`}
  description={game.tagline}
  locale={locale}
  image={{ path: `/covers/${slug}.webp`, width: 1280, height: 720, alt: t('share.cover-alt').replace('{title}', game.title) }}
  gameTitle={game.title}
>
  <noscript slot="head">
    <style is:inline>
      .play-action .play-button,
      .level-selector {
        display: none;
      }
    </style>
  </noscript>
  <div class:list={['container', 'game-page', { 'has-levels': levels }]} data-game-content>
    <section class="game-intro">
      <h1>{game.title}</h1>
      <span class="genre-badge">{t(`genre.${game.genre}`)}</span>
      <p class="tagline">{game.tagline}</p>
      <div class="play-action">
        <button type="button" class="button button-primary play-button" data-play-button>
          <Icon name="play" />
          <span data-play-label>{t('game.play')}</span>
          <span data-retry-label hidden>{t('game.retry')}</span>
        </button>
        <p class="play-error" role="alert" data-load-error data-message={t('game.load-error')}></p>
        <noscript>
          <p>{t('game.no-javascript')}</p>
        </noscript>
      </div>
    </section>
    {levels && <LevelSelector locale={locale} levels={levels} />}
    <div class="rules">
      <Content />
    </div>
    <div class="reset-progress">
      <button type="button" class="button button-danger" data-reset-button hidden>
        {t('game.reset.button')}
      </button>
    </div>
  </div>
  <GameHost locale={locale} slug={slug} title={game.title} actions={actions} hasLevels={levels !== undefined} />
</BaseLayout>

<style>
  .game-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-6);
  }

  .game-intro {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .tagline {
    color: var(--color-text-muted);
  }

  .play-action {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .play-error:empty {
    display: none;
  }

  .reset-progress:has(> [hidden]) {
    display: none;
  }

  .rules > :global(* + *) {
    margin-top: var(--space-3);
  }

  .rules > :global(* + h2) {
    margin-top: var(--space-5);
  }

  .rules :global(h2) {
    font-size: var(--font-size-xl);
  }

  /* Below 640px, one card per row: the column headers are only read by assistive technologies. */
  .rules :global(table),
  .rules :global(tbody) {
    display: block;
    width: 100%;
    max-width: var(--measure);
    font-size: var(--font-size-sm);
  }

  .rules :global(thead) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .rules :global(tbody tr) {
    display: block;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  /* A floated label with a hanging indent: a cell mixes text and keys, which a grid would split into separate items. */
  .rules :global(td) {
    --label-width: calc(var(--space-8) + var(--space-4));

    display: block;
    padding-inline-start: calc(var(--label-width) + var(--space-3));
    overflow-wrap: break-word;
  }

  .rules :global(td + td) {
    margin-top: var(--space-2);
  }

  .rules :global(td:first-child) {
    padding-inline-start: 0;
    font-weight: 600;
  }

  .rules :global(th),
  .rules :global(td:not(:first-child)::before) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rules :global(td:not(:first-child)::before) {
    content: attr(data-label) / '';
    float: inline-start;
    width: var(--label-width);
    margin-inline-start: calc(-1 * (var(--label-width) + var(--space-3)));
  }

  .rules :global(code) {
    padding: 2px 6px;
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .rules :global(table) {
      display: table;
      border-collapse: collapse;
    }

    .rules :global(thead) {
      display: table-header-group;
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }

    .rules :global(tbody) {
      display: table-row-group;
    }

    .rules :global(tbody tr) {
      display: table-row;
      padding-block: 0;
      border-bottom: 0;
    }

    .rules :global(th),
    .rules :global(td) {
      display: table-cell;
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--color-border);
      text-align: start;
      vertical-align: top;
    }

    .rules :global(td + td) {
      margin-top: 0;
    }

    .rules :global(td:first-child) {
      padding-inline-start: var(--space-4);
      font-weight: 400;
    }

    .rules :global(td:not(:first-child)::before) {
      content: none;
    }
  }

  @media (min-width: 1024px) {
    .game-page.has-levels {
      grid-template-columns: minmax(0, 23rem) minmax(0, 1fr);
    }

    .game-page.has-levels > :not(.level-selector, .rules) {
      grid-column: 1 / -1;
    }
  }
</style>
